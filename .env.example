# ==============================================================================
# AI Tax Consultant - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8001,https://localhost,http://localhost:5500

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Pinecone Vector Database Configuration
# ------------------------------------------------------------------------------
# Get your Pinecone credentials at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_HOST=your-index-host.svc.pinecone.io
PINECONE_NAMESPACE=income_tax_act_1961
PINECONE_TOP_K=4

# ------------------------------------------------------------------------------
# Google OAuth & Authentication
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Secret key used for signing session JWT tokens:
# You can generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# ------------------------------------------------------------------------------
# MongoDB Database Configuration
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=taxassist_user

# ------------------------------------------------------------------------------
# Dodo Payments Integration
# ------------------------------------------------------------------------------
# Dodo Payments Dashboard: https://test.dodopayments.com/
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=your_product_id_here
DODO_RETURN_URL=http://localhost:8001/payment_status

# ------------------------------------------------------------------------------
# Optional Supplementary Documents
# ------------------------------------------------------------------------------
# Path to an optional local reference PDF (e.g. Finance Bill):
SUPPLEMENTARY_PDF_PATH=
